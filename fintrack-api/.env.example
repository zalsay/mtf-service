# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=fintrack_db
DB_SSLMODE=disable

# Server Configuration
SERVER_PORT=59000
ENVIRONMENT=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRATION_HOURS=24

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With,Content-Length
CORS_ALLOW_CREDENTIALS=true

# Internal MTF service token shared by fintrack-api, gateway, postgres-handler, and DeepSeek proxy.
MTF_SERVICE_TOKEN=fintrack-dev-token

# Redis Configuration (optional)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MTF / Inference Gateway Configuration
# In Docker / Sparky containers use host.docker.internal; on host use http://127.0.0.1:59010
INFERENCE_GATEWAY_URL=http://host.docker.internal:59010
INFERENCE_GATEWAY_TIMEOUT=120

# UZI Service Configuration
# In Docker / Sparky containers use host.docker.internal; on host use http://127.0.0.1:59011
UZI_ENABLED=true
UZI_SERVICE_URL=http://host.docker.internal:59011
UZI_SERVICE_TIMEOUT=1800
UZI_OPEN_TOKEN_TTL_SECONDS=45

# Alibaba Cloud OSS Configuration
OSS_ENABLED=false
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_PUBLIC_BASE_URL=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=uzi-reports
OSS_SIGNED_URL_TTL_SECONDS=300
OSS_DISABLE_SSL=false
OSS_USE_PATH_STYLE=false
OSS_CONNECT_TIMEOUT=10
OSS_READ_WRITE_TIMEOUT=30
OSS_INSECURE_SKIP_VERIFY=false

# OpenAI LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-3.5-turbo
OPENAI_MAX_CONTEXT_ROUNDS=3
OPENAI_TIMEOUT=60

# Postgres Handler Configuration (for token usage tracking and MTF cached predictions)
# In Docker / Sparky containers use host.docker.internal; on host use http://127.0.0.1:58004
POSTGRES_HANDLER_URL=http://host.docker.internal:58004
POSTGRES_HANDLER_TIMEOUT=10

# MTF Agent Runtime Configuration
# Direct local runtime: http://127.0.0.1:7878
# Via inference gateway proxy: http://host.docker.internal:59010/deepseek-tui
MTF_AGENT_ENABLED=true
MTF_AGENT_RUNTIME_URL=http://host.docker.internal:59010/deepseek-tui
MTF_AGENT_TIMEOUT=120
MTF_AGENT_MODEL=deepseek-v4-pro

# Alipay AI Pay / 402 service.
ALIPAY_SERVICE_URL=http://127.0.0.1:59100
ALIPAY_SERVICE_TOKEN=
ALIPAY_RESOURCE_ID=mtf.predict.once
ALIPAY_RESOURCE_NAME=MTF 单次预测
ALIPAY_AI_PAY_AMOUNT_CENTS=199
ALIPAY_AI_PAY_CURRENCY=CNY
ALIPAY_MERCHANT_ID=dev-merchant
ALIPAY_MERCHANT_NAME=FinTrack
ALIPAY_SERVICE_TIMEOUT=10

# Legacy env aliases still accepted by config loader:
# PORT, GIN_MODE, JWT_EXPIRY_HOURS, ALLOWED_ORIGINS
