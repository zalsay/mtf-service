# Gateway process
SERVICE_PORT=9010
GATEWAY_STORE=sqlite
GATEWAY_SQLITE_PATH=./data/gateway.db
INFERENCE_TIME_BENCHMARK_PATH=./config/inference_time_benchmarks.json

# Authentication tokens. Replace these values for a non-development deployment.
GATEWAY_API_TOKEN=fintrack-dev-token
MTF_SERVICE_TOKEN=fintrack-dev-token
POSTGRES_HANDLER_TOKEN=fintrack-dev-token

# Local backend endpoints. Override these when the backends run elsewhere.
XPU_BACKEND_URL=http://127.0.0.1:59008
XPU_CONCURRENCY=2
ROCM_BACKEND_URL=http://127.0.0.1:59009
ROCM_CONCURRENCY=1
CUDA_BACKEND_URL=
CUDA_CONCURRENCY=1
CPU_XREG_BACKEND_URL=
CPU_XREG_CONCURRENCY=0
UZI_BACKEND_URL=http://127.0.0.1:9011
UZI_CONCURRENCY=10

# Redis is used only when GATEWAY_STORE=redis.
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=ai-functions

# Result/history services
POSTGRES_HANDLER_URL=http://127.0.0.1:58004
HISTORY_SERVICE_URL=http://127.0.0.1:58004

# Disable the scheduled sync by default for direct local startup.
DAILY_STOCK_SYNC_ENABLED=false
DAILY_STOCK_SYNC_MODE=history
DAILY_STOCK_SYNC_TIMEZONE=Asia/Shanghai
DAILY_STOCK_SYNC_HOUR=22
DAILY_STOCK_SYNC_MINUTE=0
DAILY_STOCK_SYNC_EXTRA_TIMES=
DAILY_STOCK_SYNC_MAX_CONCURRENCY=4
DAILY_STOCK_SYNC_LOOKBACK_DAYS=0
A_STOCK_DAILY_URL=
A_STOCK_DAILY_CONCURRENT=50

# Optional proxy/runtime settings.
DEEPSEEK_TUI_BACKEND_URL=
DEEPSEEK_TUI_PROXY_TOKEN=fintrack-dev-token
DEEPSEEK_TUI_PROXY_PATH=/deepseek-tui
DEEPSEEK_TUI_AUTH_CONFIG_PATH=

# Override the health URL if the service is exposed through another address.
GATEWAY_HEALTHCHECK_URL=
